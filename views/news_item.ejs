<%- include('partials/header') %>
<article class="mx-auto max-w-3xl">
  <a href="/news" class="text-sm text-gold-dark hover:underline">← Все новости</a>
  <p class="mt-4 text-xs text-gold-dark"><%= fmtDate(item.created_at) %></p>
  <h1 class="h-section mb-6"><%= item.title %></h1>
  <% if (item.image_url) { %><img src="<%= item.image_url %>" class="mb-6 w-full rounded-lg"><% } %>
  <div class="whitespace-pre-line leading-relaxed"><%= item.body %></div>
</article>
<%- include('partials/footer') %>
