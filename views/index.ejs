<%- include('partials/header') %>
<section class="-mx-4 -mt-10 mb-12 bg-red-900 px-6 py-20 text-center text-white md:rounded-b-2xl">
    <img src="/img/logo_nika.jpg" alt="Ника" class="mx-auto mb-4 h-160 w-160">
  <p class="mb-3 text-sm uppercase tracking-[0.3em] text-gold">Спортивный клуб</p>
  <h1 class="font-serif text-5xl font-bold md:text-6xl">Танцевальный клуб «Ника»</h1>
  <p class="mx-auto mt-5 max-w-2xl text-lg text-stone-200">Бальные танцы для детей и взрослых: от первых шагов до выступлений на турнирах.</p>
  <div class="mt-8 flex justify-center gap-4"><a href="/schedule" class="btn">Расписание занятий</a><a href="/trainers" class="btn-outline">Наши тренеры</a></div>
</section>
<h2 class="h-section mb-6">Последние новости</h2>
<div class="grid gap-6 md:grid-cols-3">
  <% news.forEach(n => { %>
    <a href="/news/<%= n.id %>" class="card transition hover:shadow-md">
      <p class="text-xs text-gold-dark"><%= fmtDate(n.created_at) %></p>
      <h3 class="mt-1 font-serif text-xl font-semibold text-navy"><%= n.title %></h3>
      <p class="mt-2 text-sm text-slate-600"><%= n.body.slice(0, 120) %><%= n.body.length > 120 ? '…' : '' %></p>
    </a>
  <% }) %>
  <% if (!news.length) { %><p class="text-slate-500">Новостей пока нет.</p><% } %>
</div>
<%- include('partials/footer') %>
