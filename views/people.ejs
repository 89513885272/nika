<%- include('partials/header') %>
<h1 class="h-section mb-8"><%= heading %></h1>
<div class="grid gap-6 md:grid-cols-2">
  <% people.forEach(p => { %>
    <article class="card flex gap-5">
      <% if (p.photo_url) { %><img src="<%= p.photo_url %>" alt="<%= p.full_name %>" class="h-28 w-28 shrink-0 rounded object-cover">
      <% } else { %><div class="flex h-28 w-28 shrink-0 items-center justify-center rounded bg-navy font-serif text-3xl text-gold"><%= p.full_name[0] %></div><% } %>
      <div>
        <h2 class="font-serif text-xl font-semibold text-navy"><%= p.full_name %></h2>
        <p class="mt-1 text-sm text-slate-600"><%= sub(p) %></p>
        <% if (p.ach.length) { %>
          <ul class="mt-3 space-y-1 text-sm">
            <% p.ach.forEach(a => { %><li class="flex gap-2"><span class="text-gold">★</span><span><%= a.title %><%= a.year ? ' (' + a.year + ')' : '' %></span></li><% }) %>
          </ul>
        <% } %>
      </div>
    </article>
  <% }) %>
</div>
<%- include('partials/footer') %>
