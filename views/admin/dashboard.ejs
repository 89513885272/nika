<%- include('../partials/header') %>
<div class="mb-8 flex items-center justify-between">
  <h1 class="h-section">Админ-панель</h1>
  <form method="post" action="/admin/logout"><button class="btn-outline !border-navy !text-navy">Выйти</button></form>
</div>
<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <% Object.entries(E).forEach(([k, v]) => { %>
    <a href="/admin/<%= k %>" class="card text-center font-serif text-xl text-navy transition hover:border-gold hover:shadow-md"><%= v.title %></a>
  <% }) %>
</div>
<%- include('../partials/footer') %>
