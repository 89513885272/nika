{
  "name": "nika-dance-club",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm:css:watch\" \"nodemon server.js\"",
    "css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./public/css/style.css --watch",
    "db:init": "psql \"%DATABASE_URL%\" -f db/schema.sql"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "tailwindcss": "^3.4.10"
  }
}
